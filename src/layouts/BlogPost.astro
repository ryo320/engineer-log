---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';
import LikeButton from '../components/LikeButton.astro';

// プレースホルダー画像
import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

type Props = CollectionEntry<'blog'>['data'] & {
	showComments?: boolean;
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, showComments = true, headings } = Astro.props;
const toc = headings?.filter((h) => h.depth > 1 && h.depth < 4);

let displayHeroImage = heroImage;
if (!heroImage) {
	const charCodeSum = title.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
	const index = charCodeSum % placeholders.length;
	displayHeroImage = placeholders[index];
}

const url = Astro.url.href;
const id = Astro.url.pathname;
const isAboutPage = title === "About Me";
---

<html lang="ja"> 
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			:root {
				font-size: clamp(15px, 0.4vw + 13.5px, 18px);
				--accent-blue: #0071e3;
				--apple-black: #1d1d1f;
				--toc-bg: rgba(250, 250, 252, 0.82);
				scroll-behavior: smooth;
			}

			main { width: calc(100% - 2em); max-width: 100%; margin: 0; }
			.hero-image { width: 100%; }
			.hero-image img { display: block; margin: 0 auto; border-radius: 12px; box-shadow: var(--box-shadow); }

			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: #424245;
				font-size: 1.1rem;
				line-height: 1.8;
				word-break: auto-phrase;
				line-break: strict;
				overflow-wrap: break-word;
			}

			.prose p { text-wrap: pretty; margin-bottom: 1.5em; }
			.title { margin-bottom: 1.5em; padding: 0.5em 0 0 0; text-align: center; }
			.title h1 { margin: 0 0 0.3em 0; font-size: 3.2rem; font-weight: 900; color: var(--apple-black); letter-spacing: -0.03em; line-height: 1.1; text-wrap: balance; }

			.prose h2, .prose h3 { scroll-margin-top: 100px; }
			.prose h2 { font-size: 2.1rem; font-weight: 800; color: var(--apple-black); margin: 3.5rem 0 1.2rem; letter-spacing: -0.02em; line-height: 1.3; text-wrap: balance; }
			.prose h3 { font-size: 1.5rem; font-weight: 700; color: var(--apple-black); margin: 2.5rem 0 1rem; line-height: 1.4; text-wrap: balance; }

			/* --- 目次デザイン --- */
			.toc-container {
				background: var(--toc-bg);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(0, 0, 0, 0.05);
				border-radius: 20px;
				padding: 2rem;
				margin: 3.5rem 0;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
				contain: layout style;
				transform: translateZ(0); 
				will-change: transform;
			}
			.toc-title { display: flex; align-items: center; gap: 0.8rem; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1.5rem; color: #86868b; }
			.toc-list { list-style: none; padding: 0; margin: 0; counter-reset: toc-h2; }
			.toc-item { margin-bottom: 0.8rem; position: relative; }
			.toc-link { color: #424245; text-decoration: none; font-size: 1rem; font-weight: 500; transition: transform 0.25s ease, color 0.25s ease; display: inline-flex; align-items: flex-start; gap: 0.5rem; }
			.depth-2 { counter-reset: toc-h3; }
			.depth-2 .toc-link::before { counter-increment: toc-h2; content: counter(toc-h2) "."; color: var(--accent-blue); font-weight: 700; }
			.depth-3 { margin-left: 1.5rem; margin-top: 0.4rem; padding-left: 1rem; border-left: 1px solid #e5e5e7; }
			.toc-link:hover { color: var(--accent-blue); transform: translateX(6px); }

			/* --- コードブロック：行番号とコピーボタン --- */
			.prose pre {
				position: relative;
				padding: 1.5rem 0 !important;
				border-radius: 14px;
				background-color: #f5f5f7 !important;
				border: 1px solid rgba(0, 0, 0, 0.05);
				overflow-x: auto;
				margin: 2.5rem 0;
				transform: translateZ(0);
				/* 重要：カウンターのリセット */
				counter-reset: line-num;
			}

			.prose pre code {
				display: block;
				padding: 0;
				background: none !important;
				font-family: 'SF Mono', Menlo, Monaco, Consolas, monospace;
				font-size: 0.85rem;
				line-height: 1.7;
			}

			/* 各行に対するスタイル（Markdocが出力するあらゆるspanをターゲットにする） */
			.prose pre code span {
				display: block;
				padding: 0 1.5rem 0 3.8rem;
				position: relative;
				min-height: 1.5rem;
			}

			/* 行番号を表示（疑似要素なのでコピーされない） */
			.prose pre code span::before {
				counter-increment: line-num;
				content: counter(line-num);
				position: absolute;
				left: 0;
				width: 2.8rem;
				text-align: right;
				color: #86868b;
				font-size: 0.75rem;
				opacity: 0.4;
				user-select: none;
				pointer-events: none;
				font-feature-settings: "tnum";
			}

			/* コピーボタン */
			.copy-code-button {
				position: absolute;
				top: 0.7rem;
				right: 0.7rem;
				padding: 0.5rem 0.9rem;
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--apple-black);
				background: rgba(255, 255, 255, 0.8);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(0, 0, 0, 0.1);
				border-radius: 8px;
				cursor: pointer;
				opacity: 0;
				transition: all 0.2s ease;
				z-index: 100;
			}

			.prose pre:hover .copy-code-button { opacity: 1; }
			.copy-code-button:hover { background: #ffffff; transform: scale(1.05); }
			.copy-code-button.copied { color: #34c759; border-color: rgba(52, 199, 89, 0.4); }

			@media (max-width: 768px) {
				.copy-code-button { opacity: 1; }
				.prose pre code span { padding-left: 3.2rem; }
			}

			/* --- その他UI（維持） --- */
			.like-button-wrapper { display: flex; justify-content: center; margin: 0.2rem 0; }
			.title hr { margin: 0.5rem auto 1.5rem; border: 0; border-top: 1px solid #eee; }
			.date { margin-bottom: 0.5em; color: rgb(var(--gray)); font-weight: 500; }
			.comment-divider { border: 0; border-top: 1px solid #eee; margin: 4rem 0 2rem; }
			.share-trigger { position: fixed; bottom: 2.5rem; right: 2.5rem; background: #ffffff; color: var(--apple-black); border: 2px solid var(--accent-blue); padding: 0.9rem 1.6rem; border-radius: 99px; font-weight: 700; display: flex; align-items: center; gap: 0.7rem; cursor: pointer; box-shadow: 0 15px 45px rgba(0, 113, 227, 0.15); z-index: 100; transition: transform 0.4s ease, opacity 0.3s ease; }
			.share-trigger.hidden { transform: translateY(120px) scale(0.9); opacity: 0; pointer-events: none; }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article data-pagefind-body>
				<div class="hero-image">
					{displayHeroImage && <Image width={1020} height={510} src={displayHeroImage} alt={title} loading="eager" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date"><FormattedDate date={pubDate} /></div>
						<h1>{title}</h1>
						<div class="like-button-wrapper"><LikeButton slug={id} /></div>
						<hr />
					</div>

					{toc && toc.length > 0 && (
						<nav class="toc-container">
							<div class="toc-title">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
								<span>目次</span>
							</div>
							<ul class="toc-list">
								{toc.map((heading) => (
									<li class={`toc-item depth-${heading.depth}`}>
										<a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<slot />
				</div>
			</article>

			{showComments && (
				<div class="prose">
					<hr class="comment-divider" />
					<section>
						<h3 style="margin-bottom: 1.5rem;">Comments</h3>
						<Comments title={title} id={id} url={url} />
					</section>
				</div>
			)}
		</main>
		<Footer />

		{!isAboutPage && (
			<button id="scroll-share-btn" class="share-trigger" onclick="sharePage()">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
				<span>Share</span>
			</button>
		)}

		<script is:inline>
			function setupCopyButtons() {
				const preBlocks = document.querySelectorAll('pre');
				preBlocks.forEach((pre) => {
					if (pre.querySelector('.copy-code-button')) return;

					const button = document.createElement('button');
					button.className = 'copy-code-button';
					button.type = 'button';
					button.innerText = 'Copy';
					pre.appendChild(button);

					button.addEventListener('click', async () => {
						// ボタンのテキストが含まれないように全体から削る
						let fullText = pre.innerText;
						const textToCopy = fullText
							.replace(/Copy/g, '')
							.replace(/Copied!/g, '')
							.trim();

						try {
							if (navigator.clipboard && window.isSecureContext) {
								await navigator.clipboard.writeText(textToCopy);
							} else {
								throw new Error();
							}
							onSuccess(button);
						} catch (err) {
							const textArea = document.createElement("textarea");
							textArea.value = textToCopy;
							textArea.style.position = "fixed";
							textArea.style.left = "-9999px";
							document.body.appendChild(textArea);
							textArea.select();
							try {
								document.execCommand('copy');
								onSuccess(button);
							} catch (e) {
								button.innerText = 'Failed';
							}
							document.body.removeChild(textArea);
						}
					});
				});
			}

			function onSuccess(btn) {
				btn.innerText = 'Copied!';
				btn.classList.add('copied');
				setTimeout(() => {
					btn.innerText = 'Copy';
					btn.classList.remove('copied');
				}, 2000);
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupCopyButtons);
			} else {
				setupCopyButtons();
			}

			function sharePage() {
				const title = document.title;
				const url = window.location.href;
				if (navigator.share) {
					navigator.share({ title, url });
				} else {
					navigator.clipboard.writeText(url);
					alert("リンクをコピーしました！");
				}
			}

			let lastScrollY = window.scrollY;
			const shareBtn = document.getElementById('scroll-share-btn');
			if (shareBtn) {
				window.addEventListener('scroll', () => {
					const currentScrollY = window.scrollY;
					if (currentScrollY > lastScrollY && currentScrollY > 100) {
						shareBtn.classList.add('hidden');
					} else {
						shareBtn.classList.remove('hidden');
					}
					lastScrollY = currentScrollY;
				}, { passive: true });
			}
		</script>
	</body>
</html>
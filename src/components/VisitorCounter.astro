---
/* src/components/VisitorCounter.astro */
---

<div class="visitor-box">
  <div class="glow"></div>
  <div class="content">
    <span class="label">VISITORS</span>
    <span id="visitor-count" class="number">----</span>
  </div>
</div>

<style>
  .visitor-box {
    position: relative;
    display: inline-flex;
    padding: 2px;
    background: linear-gradient(135deg, #0984e3, #6c5ce7); /* LikeButtonのaccent-gradient */
    border-radius: 8px;
    overflow: hidden;
  }

  .content {
    background: #fff; /* 背景が白の場合。ダークモードなら調整 */
    padding: 0.4rem 1rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100px;
    z-index: 1;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #4a5568;
    opacity: 0.7;
  }

  .number {
    font-family: 'Inter', sans-serif; /* BaseHeadで読み込まれているフォント */
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, #0984e3, #6c5ce7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ほんのり光るエフェクト */
  .glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0984e3, #6c5ce7);
    filter: blur(8px);
    opacity: 0.3;
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  async function displayCount() {
    const { data, error } = await supabase
      .from('site_stats')
      .select('count')
      .eq('id', 'total_visitors')
      .single();

    if (!error && data) {
      const el = document.getElementById('visitor-count');
      if (el) el.innerText = Number(data.count).toLocaleString();
    }
  }

  displayCount();
</script>